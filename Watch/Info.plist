<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Muscu</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Application Watch a cible unique (watchOS 7+). -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.cyril.Muscu</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<!-- Seance Sante au poignet (lot 7) : l'application reste active
	     pendant une seance, et l'iPhone peut la lancer dans une seance
	     (HKHealthStore.startWatchApp). -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Muscu lit la fréquence cardiaque et l’énergie active mesurées pendant vos séances, pour les afficher au poignet et les ranger avec la séance. Uniquement si vous avez activé Santé dans Muscu.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Muscu enregistre dans l’app Santé les séances suivies à la montre, avec leur fréquence cardiaque et leur énergie active. Uniquement si vous avez activé Santé dans Muscu.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
