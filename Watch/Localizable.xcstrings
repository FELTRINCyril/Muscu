    "La séance a avancé sur l’iPhone : rien n’a été validé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout moved on on the iPhone: nothing was logged."
          }
        }
      }
    },
    "La séance démarre sur l’iPhone et se suit ici.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout starts on the iPhone and is followed here."
          }
        }
      }
    },
    "La séance n’a pas pu être préparée pour l’envoi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout couldn’t be prepared for sending."
          }
        }
      }
    },
    "La séance part vers l’iPhone. Elle n’y sera ajoutée qu’une seule fois, même si l’envoi est rejoué.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout goes to the iPhone. It will be added there only once, even if the transfer is replayed."
          }
        }
      }
    },
    "La séance sera envoyée à l’iPhone, qui la conservera dans l’historique.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout will be sent to the iPhone, which will keep it in the history."
          }
        }
      }
    },
    "Le repos est déjà terminé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest is already over."
          }
        }
      }
    },
    "L’iPhone n’a pas pu enregistrer : rien n’a été validé.": {
