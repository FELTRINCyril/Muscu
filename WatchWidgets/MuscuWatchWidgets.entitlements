<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La complication lit le resume depose par l'application de la
	     montre dans ce groupe. Elle n'a acces a rien d'autre. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cyril.Muscu</string>
	</array>
</dict>
</plist>
