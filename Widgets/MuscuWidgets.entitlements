<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Le widget lit l'instantane ecrit par l'application dans ce groupe.
	     Il n'a acces a rien d'autre : ni base, ni photos, ni Trousseau. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cyril.Muscu</string>
	</array>
</dict>
</plist>
