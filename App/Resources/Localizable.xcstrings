            "value": "Indice de force de %1$@ sur %2$@, %3$lld exercice(s)."
          }
        }
      }
    },
    "Indice de force non calculable : aucun exercice principal n’a de 1RM estimable sur %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength index unavailable: no main exercise has an estimable 1RM over %@."
          }
        }
