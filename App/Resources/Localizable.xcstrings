          }
        }
      }
    },
    "Vos données restent utilisables hors ligne en permanence. La synchronisation ne fait que les recopier entre vos appareils.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays usable offline at all times. Syncing only copies it between your devices."
          }
        }
      }
    },
    "Vos records de 1RM et de répétitions apparaîtront ici au fil des séances.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 1RM and repetition records will appear here as you train."
