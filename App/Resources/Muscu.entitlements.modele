<?xml version="1.0" encoding="UTF-8"?>
<!--
  MODÈLE d'entitlements pour la synchronisation iCloud.

  Ce fichier n'est PAS actif : il n'est pas référencé par project.yml.
  Il décrit ce qu'il faudra activer une fois le conteneur CloudKit créé
  dans le compte développeur. Voir docs/configuration/icloud.md.

  Tant qu'il n'est pas activé, l'application fonctionne entièrement hors
  ligne et l'écran Synchronisation affiche « non configurée ».
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.cyril.Muscu</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
